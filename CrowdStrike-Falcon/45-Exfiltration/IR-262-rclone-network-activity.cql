// IR-262 - Rclone Network Activity
// Purpose: Identify outbound connections generated by rclone.
// MITRE ATT&CK: T1567.002
#event_simpleName=NetworkConnectIP4
ContextBaseFileName="rclone.exe"
| table([@timestamp,ComputerName,LocalAddressIP4,RemoteAddressIP4,RemotePort,ContextProcessId], limit=20000)