ParentBaseFileName=cmd.exe 
GrandParentBaseFileName!=explorer.exe 
GrandParentBaseFileName=*

| in(
    FileName,
    ignoreCase=true,
    values=[
        "whoami.exe",
        "hostname.exe",
        "ipconfig.exe",
        "net.exe"
    ]
)

| groupBy(
    [
        ComputerName,
        GrandParentBaseFileName,
        FileName
    ],
    limit=1000000
)

| groupBy(
    [
        ComputerName,
        GrandParentBaseFileName
    ],
    limit=1000000
)

| _count > 2
